{
  "mcpServers": {
    "factgrid-local": {
      "command": "uv",
      "args": ["--directory", "mcp", "run", "factgrid-mcp"],
      "env": {
        "QLEVER_ENDPOINT": "http://localhost:7003",
        "QLEVER_ACCESS_TOKEN": "factgrid_lokal_bitte_aendern",
        "QLEVER_SERVER_TIMEOUT": "120",
        "FACTGRID_LANG": "de",
        "FACTGRID_INSTANCE_OF": "P2",
        "FACTGRID_MAX_ROWS": "200",
        "FACTGRID_TEXT_INDEX": "0"
      }
    }
  }
}
