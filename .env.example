# Umgebungsvariablen für den MCP-Server (factgrid-mcp) und die Skripte
QLEVER_ENDPOINT=http://localhost:7003
QLEVER_ACCESS_TOKEN=factgrid_lokal_bitte_aendern   # wie ACCESS_TOKEN im Qleverfile
QLEVER_SERVER_TIMEOUT=120                        # wie TIMEOUT im Qleverfile
FACTGRID_BASE=https://database.factgrid.de/
FACTGRID_LANG=de
FACTGRID_INSTANCE_OF=P2
FACTGRID_MAX_ROWS=200
FACTGRID_TIMEOUT=60
FACTGRID_TEXT_INDEX=0
FACTGRID_MCP_PORT=8765
FACTGRID_CHAT_PORT=8177                          # Web-Chatbot (make chat)
FACTGRID_DUMP_URL=https://database.factgrid.de/dumps/

# MediaWiki-Datenbank (Bearbeitungsgeschichte): Spiegel des monatlichen SQL-Dumps in der
# lokalen MariaDB, s. README 3.7. `make mwdb` lädt den neuesten Dump aus MW_DUMP_DIR, legt den
# Lesebenutzer an und trägt MW_DB_PASSWORD hier ein (nur SELECT auf MW_DB_NAME).
MW_DUMP_DIR=/srv/data/factgrid/mediawiki
MW_DB_HOST=127.0.0.1
MW_DB_PORT=3306
MW_DB_NAME=factgrid_mw
MW_DB_USER=factgrid_ro
#MW_DB_PASSWORD=                                  # wird von make mwdb erzeugt
MW_DB_TIMEOUT=60                                 # Sekunden je Abfrage (max_statement_time)
#MW_DB_ADMIN=mariadb                             # Admin-Client für make mwdb (z. B. "mariadb -uroot -pGEHEIM")

# LLM-Zugang für `make agent` und `make chat`. Der Index bleibt lokal, Fragen und
# Query-Ergebnisse gehen an den jeweiligen Anbieter.

# OpenRouter (Default; Responses-API https://openrouter.ai/api/v1/responses)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=z-ai/glm-5.3-flash              # Default für make agent und make chat
#OPENROUTER_MODELS=z-ai/glm-5.3-flash,anthropic/claude-opus-5   # Auswahl im Chat-Dropdown
#OPENROUTER_SITE_URL=http://127.0.0.1:8177       # optional, HTTP-Referer (Rankings)
#OPENROUTER_SITE_NAME=FactGrid lokal             # optional, X-Title (Rankings)
#AGENT_MODEL=anthropic/claude-opus-5             # überschreibt nur den Default von make agent

# Anthropic (für Claude Code; im Chat und im Agenten wählbar). Alternative zum Schlüssel:
# `ant auth login` (Profil unter ~/.config/anthropic/), die SDKs finden es von selbst.
#ANTHROPIC_API_KEY=sk-ant-...

# OpenAI direkt (dritter Anbieter im Web-Chatbot) – nur setzen, wenn gewünscht.
#OPENAI_API_KEY=sk-...

# DeepSeek (vierter Anbieter im Web-Chatbot; OpenAI-kompatible Chat-Completions-API).
# Modell-IDs laut https://api-docs.deepseek.com: deepseek-flash (= DeepSeek V4.1 Flash).
#DEEPSEEK_API_KEY=sk-...
#DEEPSEEK_THINKING=enabled                       # enabled | disabled (Denkmodus, Default enabled)
#DEEPSEEK_REASONING_EFFORT=                      # low | high (leer = API-Default)
#DEEPSEEK_MAX_TOKENS=16384

# Wochenbriefing (scripts/weekly_briefing.py, ops/factgrid-briefing.timer): Empfänger,
# Modell und das Postfach, über das verschickt wird. Der Absender ist mailadresse.
#BRIEFING_TO=factgrid-community@listserv.dfn.de
#BRIEFING_MODEL=deepseek-flash
#BRIEFING_FROM_NAME=FactGrid
# Postfach (Namen wie im Provider-Formular; POP3 wird nicht gebraucht, SMTP ist der SSL-Port)
#host_name=mx.example.net
#mailadresse=factgrid@example.org
#mail_password=...
#SMTP=465

# Anmeldung am Web-Chat: FactGrid-Konto über MediaWiki-OAuth 1.0a. Consumer anlegen unter
# https://database.factgrid.de/wiki/Special:OAuthConsumerRegistration/propose - es genügen die
# Grundrechte ("Basic rights"), der Chat schreibt nichts im Wiki. Als Rückruf-Adresse dort
# <öffentliche Adresse dieses Chats>/api/oauth/callback eintragen; mitgeschickt wird sie nicht
# (oauth_callback=oob), das Wiki nimmt die eingetragene. Bleiben KEY und SECRET leer, läuft der
# Chat ohne Anmeldung - dann startet er nur noch auf 127.0.0.1.
#FACTGRID_OAUTH_KEY=
#FACTGRID_OAUTH_SECRET=
#FACTGRID_OAUTH_CALLBACK=          # eigene Rückruf-Adresse - nur bei "callback is prefix"
#FACTGRID_OAUTH_URL=               # anderes Wiki als FACTGRID_BASE (…/w/index.php)
#FACTGRID_CHAT_SESSION_TTL=43200   # Sekunden, die eine Anmeldung hier gilt (12 h)

# Web-Chat: freigeschaltete Modelle ("anbieter/modell", Komma-Liste) und Vorauswahl. Der
# Schlüssel eines Anbieters kommt aus dem Benutzerprofil (Dialog „Schlüssel“) oder aus .env.
#FACTGRID_CHAT_MODELS=openai/gpt-5.6-luna,deepseek/deepseek-flash
#FACTGRID_CHAT_MODEL=openai/gpt-5.6-luna
# Ablage der Gespräche für die Seitenleiste (je Benutzer ein Ordner, je Gespräch eine JSON-Datei).
#FACTGRID_CHAT_HISTORY=.chat-history
# Buchhaltung: je Antwort eine Zeile (wer, welches Modell, wie viele Tokens). `make usage` zählt aus.
#FACTGRID_CHAT_USAGE=.chat-usage.jsonl
