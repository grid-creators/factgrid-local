# Umgebungsvariablen für den MCP-Server (factgrid-mcp) und die Skripte
QLEVER_ENDPOINT=http://localhost:7003
QLEVER_ACCESS_TOKEN=factgrid_lokal_bitte_aendern   # wie ACCESS_TOKEN im Qleverfile
QLEVER_SERVER_TIMEOUT=120                        # wie TIMEOUT im Qleverfile
FACTGRID_BASE=https://database.factgrid.de/
FACTGRID_LANG=de
FACTGRID_INSTANCE_OF=P2
FACTGRID_MAX_ROWS=200
FACTGRID_TIMEOUT=60
FACTGRID_TEXT_INDEX=0
FACTGRID_MCP_PORT=8765
FACTGRID_CHAT_PORT=8177                          # Web-Chatbot (make chat)
FACTGRID_DUMP_URL=https://database.factgrid.de/dumps/

# LLM-Zugang für `make agent` und `make chat`. Der Index bleibt lokal, Fragen und
# Query-Ergebnisse gehen an den jeweiligen Anbieter.

# OpenRouter (Default; Responses-API https://openrouter.ai/api/v1/responses)
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=z-ai/glm-5.3-flash              # Default für make agent und make chat
#OPENROUTER_MODELS=z-ai/glm-5.3-flash,anthropic/claude-opus-5   # Auswahl im Chat-Dropdown
#OPENROUTER_SITE_URL=http://127.0.0.1:8177       # optional, HTTP-Referer (Rankings)
#OPENROUTER_SITE_NAME=FactGrid lokal             # optional, X-Title (Rankings)
#AGENT_MODEL=anthropic/claude-opus-5             # überschreibt nur den Default von make agent

# Anthropic (für Claude Code; im Chat und im Agenten wählbar). Alternative zum Schlüssel:
# `ant auth login` (Profil unter ~/.config/anthropic/), die SDKs finden es von selbst.
#ANTHROPIC_API_KEY=sk-ant-...

# OpenAI direkt (dritter Anbieter im Web-Chatbot) – nur setzen, wenn gewünscht.
#OPENAI_API_KEY=sk-...
