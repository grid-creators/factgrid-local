# /etc/systemd/system/factgrid-briefing.timer
# Freitags 08:00 Europe/Berlin (MESZ/MEZ - die Ortszeit steht explizit in OnCalendar, damit es
# über die Zeitumstellung hinweg 08:00 Ortszeit bleibt; systemd >= 252 versteht die Zonenangabe).
# Der MediaWiki-Spiegel ist seit 06:00 des Tages frisch und reicht bis zum Vortag (Donnerstag).
# Persistent: war die Maschine am Freitag aus, holt der Timer den Lauf nach - das Skript rechnet
# den Zeitraum aus der Laufzeit.
[Unit]
Description=Wöchentliches FactGrid-Briefing (freitags 08:00 Ortszeit)

[Timer]
OnCalendar=Fri *-*-* 08:00:00 Europe/Berlin
Persistent=true

[Install]
WantedBy=timers.target
